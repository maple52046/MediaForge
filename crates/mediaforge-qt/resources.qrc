<RCC>
  <qresource prefix="/">
    <file alias="qtquickcontrols2.conf">../../qml/qtquickcontrols2.conf</file>
  </qresource>
  <qresource prefix="/mediaforge">
    <file alias="qml/Main.qml">../../qml/Main.qml</file>
    <file alias="qml/components/ConversionPanel.qml">../../qml/components/ConversionPanel.qml</file>
    <file alias="qml/components/MediaDetails.qml">../../qml/components/MediaDetails.qml</file>
    <file alias="qml/components/PreviewPane.qml">../../qml/components/PreviewPane.qml</file>
    <file alias="qml/controls/TrimTimeline.qml">../../qml/controls/TrimTimeline.qml</file>
    <file alias="qml/lib/strings.js">../../qml/lib/strings.js</file>
    <file alias="qml/lib/source.js">../../qml/lib/source.js</file>
    <file alias="qml/lib/time.js">../../qml/lib/time.js</file>
    <file alias="qml/theme/AppTheme.qml">../../qml/theme/AppTheme.qml</file>
    <file alias="icons/cloud-upload-outlined.svg">../../assets/icons/cloud-upload-outlined.svg</file>
    <file alias="icons/pause-outlined.svg">../../assets/icons/pause-outlined.svg</file>
    <file alias="icons/play-outlined.svg">../../assets/icons/play-outlined.svg</file>
  </qresource>
</RCC>
